<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve existing files and directories as-is.
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Everything else falls through to the SPA entry point so client-side
    # routes such as /admin/orders work on a hard refresh.
    RewriteRule . /index.html [L]
</IfModule>
